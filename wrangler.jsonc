{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cangku-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker near the Turso database (Tokyo) instead of near the phone: one long hop per request
  // instead of one per query.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference binding required by OpenNext; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "cangku-hub" }
  ]
  // Secrets (TURSO_*, ANTHROPIC_API_KEY): `wrangler secret put`; locally use .dev.vars.
}
